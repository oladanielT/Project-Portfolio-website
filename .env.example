# Supabase project → Connect / API keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project settings → API keys → legacy service_role key. SERVER ONLY; never NEXT_PUBLIC.
# Required for serving published uploads and accepting inquiries.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical origin. Use http://localhost:3000 for local development.
SITE_URL=http://localhost:3000

# Secret key required to access /admin and /api/admin (cloaks admin behind 404 if missing)
ADMIN_SECRET_KEY=
